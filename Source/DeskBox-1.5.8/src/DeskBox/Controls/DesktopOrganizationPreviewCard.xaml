<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PreviewFileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupSelectionToggleStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Root carries the templated background so the whole row
                             hit-tests; without it the empty title area is dead space
                             even though it looks like part of the toggle. -->
                        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*"
                              Background="{TemplateBinding Background}"
                              CornerRadius="4">
                            <Border x:Name="SelectionBox" Width="24" Height="24" CornerRadius="8"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="Transparent">
                                <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <!-- Single cartesian group (the official CheckBox pattern):
                                     separate CommonStates/CheckStates groups would both write
                                     SelectionBox.Background and the most recently entered
                                     state wins, erasing the checked fill while hovering.
                                     Row-as-toggle: hover lights the row in both check
                                     states, mirroring the file tile's Subtle treatment. -->
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorQuarternaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="#FFBC23" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <SystemBackdropElement x:Name="MaterialSurface" IsHitTestVisible="False" />
        <Border x:Name="FallbackSurface" IsHitTestVisible="False" />
        <Border x:Name="CardOutline" MinHeight="96" MaxHeight="420"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="CardScale" /></Border.RenderTransform>
            <Grid RowDefinitions="Auto,*,Auto">
                <Border x:Name="AccentBar" Grid.RowSpan="3" Height="3" VerticalAlignment="Top"
                        CornerRadius="22,22,0,0" IsHitTestVisible="False" Opacity="0.9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFB800" Offset="0" />
                            <GradientStop Color="#FFD75E" Offset="0.55" />
                            <GradientStop Color="#00FFD75E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="HeaderDivider" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="ReadOnlyTitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" Visibility="Collapsed" />
                            <CheckBox x:Name="GroupCheckBox" MinWidth="0" HorizontalAlignment="Stretch"
                                      Style="{StaticResource GroupSelectionToggleStyle}"
                                      Checked="GroupCheckBox_Changed" Unchecked="GroupCheckBox_Changed">
                                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </Grid>
                        <Border x:Name="CountChip" Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="14" Padding="12,4" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="DestinationButton" Grid.Row="1" Grid.ColumnSpan="2" MinWidth="0" MinHeight="40" Background="#FFFAE9" BorderBrush="#F5EACB" CornerRadius="10"
                                FontSize="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock x:Name="DestinationText" TextTrimming="CharacterEllipsis" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="DestinationFlyout" Placement="Bottom" />
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="GroupDescriptionText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="1" Margin="8,6"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                              HorizontalContentAlignment="Stretch" Padding="2,0,2,0">
                    <Grid x:Name="ItemsPanel" Margin="2,4" SizeChanged="ItemsPanel_SizeChanged" />
                </ScrollViewer>
                <Button x:Name="ExpandButton" Grid.Row="2" HorizontalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" FontSize="12"
                        Click="ExpandButton_Click" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
