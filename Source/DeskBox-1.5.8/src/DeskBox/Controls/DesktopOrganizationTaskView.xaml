<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationTaskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,8"/></Style>
        <Style TargetType="DropDownButton"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,8"/></Style>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFBC23" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFD75E" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#252216" />
        <Style x:Key="NaiWaMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="RailNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Storyboard x:Key="AmbientStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbOneTransform" Storyboard.TargetProperty="X"
                             From="-28" To="36" Duration="0:0:16" />
            <DoubleAnimation Storyboard.TargetName="OrbOneTransform" Storyboard.TargetProperty="Y"
                             From="-10" To="26" Duration="0:0:19" />
            <DoubleAnimation Storyboard.TargetName="OrbTwoTransform" Storyboard.TargetProperty="X"
                             From="24" To="-30" Duration="0:0:21" />
            <DoubleAnimation Storyboard.TargetName="OrbTwoTransform" Storyboard.TargetProperty="Y"
                             From="18" To="-22" Duration="0:0:17" />
            <DoubleAnimation Storyboard.TargetName="HeroPetTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-7" Duration="0:0:3.6" />
            <DoubleAnimation Storyboard.TargetName="HeroPetTransform" Storyboard.TargetProperty="X"
                             From="0" To="5" Duration="0:0:4.4" />
        </Storyboard>
        <Storyboard x:Key="BubbleStoryboard">
            <DoubleAnimation Storyboard.TargetName="HeroPetBubble" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX"
                             From="0.8" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY"
                             From="0.8" To="1" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="MascotClickStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeroPetScale" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="1.09" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeroPetScale" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="1.09" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="MascotBurstStoryboard">
            <DoubleAnimation Storyboard.TargetName="BurstOne" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstOneTransform" Storyboard.TargetProperty="X" From="0" To="-62" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstOneTransform" Storyboard.TargetProperty="Y" From="0" To="-48" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstTwo" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstTwoTransform" Storyboard.TargetProperty="X" From="0" To="64" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstTwoTransform" Storyboard.TargetProperty="Y" From="0" To="-52" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstThree" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstThreeTransform" Storyboard.TargetProperty="X" From="0" To="-48" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstThreeTransform" Storyboard.TargetProperty="Y" From="0" To="56" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstFour" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstFourTransform" Storyboard.TargetProperty="X" From="0" To="58" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="BurstFourTransform" Storyboard.TargetProperty="Y" From="0" To="52" Duration="0:0:0.7" />
        </Storyboard>
        <Style x:Key="DesktopOrganizationSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NeutralSourceCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" ColumnDefinitions="Auto,*">
                            <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <!-- Single cartesian group (the official CheckBox pattern):
                                     separate CommonStates/CheckStates groups would both write
                                     SelectionBox.Background and the most recently entered
                                     state wins, erasing the checked fill while hovering. -->
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorQuarternaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="TaskRoot" ColumnDefinitions="176,*" SizeChanged="TaskRoot_SizeChanged">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFDF7" Offset="0" />
          <GradientStop Color="#FFFFF6DD" Offset="0.55" />
          <GradientStop Color="#FFFFF0C7" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
        <Ellipse x:Name="OrbOne" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-240,0,0" Opacity="0.5">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#66FFD75E" Offset="0" />
              <GradientStop Color="#00FFD75E" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><TranslateTransform x:Name="OrbOneTransform" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbTwo" Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-180" Opacity="0.42">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#55FFC95C" Offset="0" />
              <GradientStop Color="#00FFC95C" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTwoTransform" /></Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
      <Border x:Name="IndexRail" Grid.Column="0" Margin="12,12,0,12" CornerRadius="24"
              Background="#FCF8EE" BorderBrush="#EEE7D7" BorderThickness="1" Padding="12,18,12,12">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="9">
            <Button x:Name="PendingButton" Click="NaiWaPending_Click" Style="{StaticResource RailNavButtonStyle}" Background="#FFF1C9"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="PendingButtonIcon" Glyph="&#xE8B7;" FontSize="18"/><TextBlock x:Name="PendingButtonText" Text="待整理" FontSize="14"/></StackPanel></Button>
            <Button Click="NaiWaRetained_Click" Style="{StaticResource RailNavButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="18"/><TextBlock Text="留在桌面" FontSize="14"/></StackPanel></Button>
            <Border Height="1" Background="#EEE7D7" Margin="6,10" />
            <Button Click="SmartClassify_Click" Style="{StaticResource RailNavButtonStyle}" Background="#FFD75E" Foreground="#252216" BorderBrush="#E9BA3C" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE945;" FontSize="18"/><TextBlock Text="智能分类" FontSize="14" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Click="UndoAiViewsButton_Click" Style="{StaticResource RailNavButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7A7;" FontSize="18"/><TextBlock Text="撤销引用" FontSize="14"/></StackPanel></Button>
          </StackPanel>
          <Grid x:Name="HeroDeco" Grid.Row="1" Width="150" Height="132" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,-6" Background="Transparent" Tapped="HeroPet_Tapped"
                PointerEntered="HeroPet_PointerEntered" PointerExited="HeroPet_PointerExited"
                ToolTipService.ToolTip="摸摸奶蛙">
              <Ellipse Width="186" Height="74" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0.45">
                  <Ellipse.Fill>
                      <RadialGradientBrush>
                          <GradientStop Color="#99FFC93C" Offset="0" />
                          <GradientStop Color="#00FFC93C" Offset="1" />
                      </RadialGradientBrush>
                  </Ellipse.Fill>
              </Ellipse>
              <Ellipse Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0.26">
                  <Ellipse.Fill>
                      <RadialGradientBrush>
                          <GradientStop Color="#AAFFFFFF" Offset="0" />
                          <GradientStop Color="#00FFFFFF" Offset="1" />
                      </RadialGradientBrush>
                  </Ellipse.Fill>
              </Ellipse>
              <Image Source="ms-appx:///Assets/NaiWa/head-hd.png" Width="140" Height="104"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-2" Stretch="Uniform">
                  <Image.RenderTransform>
                      <TransformGroup>
                          <ScaleTransform x:Name="HeroPetScale" CenterX="70" CenterY="56" />
                          <ScaleTransform x:Name="HeroPetHoverScale" CenterX="70" CenterY="56" />
                          <TranslateTransform x:Name="HeroPetTransform" />
                      </TransformGroup>
                  </Image.RenderTransform>
              </Image>
              <Border x:Name="HeroPetBubble" Background="#FFFFFDF2" BorderBrush="#F2DFA8" BorderThickness="1"
                      CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,0,0,0" Visibility="Collapsed" RenderTransformOrigin="0.5,1">
                  <Border.RenderTransform><ScaleTransform x:Name="BubbleScale" ScaleX="0.8" ScaleY="0.8" /></Border.RenderTransform>
                  <TextBlock Text="交给我吧～" FontSize="12" Foreground="#5C4A22" />
              </Border>
              <FontIcon x:Name="BurstOne" Glyph="&#xE734;" FontSize="14" Foreground="#FFFFB800" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <FontIcon.RenderTransform><TranslateTransform x:Name="BurstOneTransform" /></FontIcon.RenderTransform>
              </FontIcon>
              <FontIcon x:Name="BurstTwo" Glyph="&#xEB51;" FontSize="13" Foreground="#FFFF8A65" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <FontIcon.RenderTransform><TranslateTransform x:Name="BurstTwoTransform" /></FontIcon.RenderTransform>
              </FontIcon>
              <FontIcon x:Name="BurstThree" Glyph="&#xE734;" FontSize="12" Foreground="#FFFFD75E" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <FontIcon.RenderTransform><TranslateTransform x:Name="BurstThreeTransform" /></FontIcon.RenderTransform>
              </FontIcon>
              <Ellipse x:Name="BurstFour" Width="9" Height="9" Fill="#FF7BC96F" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="BurstFourTransform" /></Ellipse.RenderTransform>
              </Ellipse>
          </Grid>        </Grid>
      </Border>
    <Grid Grid.Column="1" Padding="20,14,20,12" RowSpacing="12" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid.Transitions>
          <TransitionCollection>
            <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
          </TransitionCollection>
        </Grid.Transitions>
        <Border x:Name="IndexBar" Background="#FFF7E4" CornerRadius="18" Padding="12,4" BorderThickness="1" BorderBrush="#F4E6C2">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
            <SelectorBar x:Name="PreviewSections" SelectionChanged="PreviewSections_SelectionChanged"
                         VerticalAlignment="Center">
                <SelectorBarItem x:Name="SummaryTitle" IsSelected="True" />
                <SelectorBarItem x:Name="ExcludedItemsButton" />
            </SelectorBar>
            <TextBlock x:Name="SummaryDescription" Grid.Column="1" FontSize="12" Margin="12,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ContentControl x:Name="SourceSelectionHost" Grid.Column="2" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch">
                <DropDownButton MinWidth="0" Height="40" Padding="10,0">
                    <TextBlock x:Name="SourceScopeText" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="12" MinWidth="220">
                                <CheckBox x:Name="PersonalDesktopSourceButton" MinWidth="0" MaxWidth="260" Style="{StaticResource NeutralSourceCheckBoxStyle}" IsChecked="True"
                                          Checked="SourceSelection_Changed" Unchecked="SourceSelection_Changed">
                                    <TextBlock x:Name="PersonalSourceText" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="PublicDesktopSourceButton" MinWidth="0" MaxWidth="260" Style="{StaticResource NeutralSourceCheckBoxStyle}" IsChecked="False"
                                          Checked="SourceSelection_Changed" Unchecked="SourceSelection_Changed">
                                    <TextBlock x:Name="PublicSourceText" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </ContentControl>
            <Button x:Name="RefreshButton" Grid.Column="3" Height="40" Padding="10,0" Click="RefreshButton_Click" />
            <Button x:Name="LocationsButton" Grid.Column="4" Height="40" Padding="10,0">
                <Button.Flyout>
                    <Flyout x:Name="LocationsFlyout">
                        <StackPanel Spacing="8" MaxWidth="400">
                            <TextBlock x:Name="SourcePathsTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="PersonalDesktopPathText" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="PublicDesktopPathText" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="StorageSectionTitleText" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="StorageSectionDescriptionText" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock x:Name="PathTitleText" Visibility="Collapsed" />
                            <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" FontSize="12"
                                       ToolTipService.ToolTip="{x:Bind StoragePathText.Text, Mode=OneWay}" />
                            <StackPanel x:Name="DestinationPathsPanel" Spacing="6" />
                            <Button x:Name="ChangePathButton" Click="ChangePathButton_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="MoreButton" Grid.Column="5" Height="40" Padding="8,0" Click="MoreButton_Click">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True"
                                MenuFlyoutPresenterStyle="{StaticResource NaiWaMenuFlyoutPresenterStyle}">
                        <ToggleMenuFlyoutItem x:Name="DarkThemeMenuItem" Text="深色风格" Click="NaiWaDarkTheme_Click" />
                        <ToggleMenuFlyoutItem x:Name="TransparentBodyMenuItem" Text="分类格子透明" Click="NaiWaTransparency_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="ResetSelectionMenuItem" Text="重置选择" Click="ResetSelectionMenuItem_Click" />
                        <MenuFlyoutItem Text="退出整理组件" Click="ExitOrganizer_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Spacing="6">
            <Border x:Name="HeroBanner" CornerRadius="18" Padding="16,12" BorderThickness="1" BorderBrush="#F2DFA8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFF4CB" Offset="0" />
                        <GradientStop Color="#FFFFE49C" Offset="0.62" />
                        <GradientStop Color="#FFFFD978" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid MinHeight="0" ColumnDefinitions="*" ColumnSpacing="12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="桌面整理" FontSize="21" FontWeight="SemiBold" Foreground="#2B2412" />
                                <Border Background="#3DFFFFFF" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="AI 辅助" FontSize="11" Foreground="#3A2F12" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SmartClassifyButton" Click="SmartClassify_Click" Height="36" Background="#FFD75E" Foreground="#252216" BorderBrush="#E9BA3C" BorderThickness="1" Padding="18,0" CornerRadius="14">
                                    <TextBlock Text="智能细分" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Button>
                                <CheckBox x:Name="AiRefineCheckBox" Content="允许 AI 细化" ToolTipService.ToolTip="允许将本次选中项目的显示名称和后缀发送给奶蛙已配置的模型；不发送文件内容。" VerticalAlignment="Center" Foreground="#3A2F12"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                <TextBlock Text="处理方式" FontSize="12" Foreground="#5C4A22" VerticalAlignment="Center" />
                                <ComboBox x:Name="SourceBehaviorBox" Grid.Column="1" Height="40" MinWidth="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="SourceBehaviorBox_SelectionChanged" HorizontalContentAlignment="Left">
                                    <ComboBoxItem Content="留在原位 · 仅显示引用"/>
                                    <ComboBoxItem Content="移动源文件 · 搬入收纳目录"/>
                                    <ComboBoxItem Content="留在原位 · 创建快捷方式"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="搬运动画" FontSize="12" Foreground="#5C4A22" VerticalAlignment="Center" />
                                <ComboBox x:Name="CarryAnimationBox" Grid.Column="3" Height="40" MinWidth="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="CarryAnimationBox_SelectionChanged" HorizontalContentAlignment="Left">
                                    <ComboBoxItem Content="完整动画 · 逐类搬运"/>
                                    <ComboBoxItem Content="简易动画 · 只播一次"/>
                                    <ComboBoxItem Content="无动画 · 直接落格"/>
                                </ComboBox>
                            </Grid>
                            <StackPanel x:Name="SmartStatusRow" Orientation="Horizontal" Spacing="7" Visibility="Collapsed">
                                <ProgressRing x:Name="SmartProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                <TextBlock x:Name="SmartClassifyStatus" FontSize="12" TextWrapping="Wrap" Foreground="#6B5628" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <InfoBar x:Name="SelectionFeedbackInfo" IsClosable="True" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="ViewPendingButton" Click="ViewPendingButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ResultInfo" IsClosable="True" IsOpen="False" />
            <InfoBar x:Name="RecoveryInfo" IsClosable="False" Severity="Warning" IsOpen="False">
                <!-- A single inline hyperlink stays on one line in the content
                     region, so it cannot collide with the action slot; the
                     ActionButton slot itself only accepts one ButtonBase. -->
                <InfoBar.Content>
                    <HyperlinkButton x:Name="AbandonRecoveryButton" Click="AbandonRecoveryButton_Click"
                                     VerticalAlignment="Center" Padding="0" />
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button x:Name="RecoverButton" Click="RecoverButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <ContentControl x:Name="RetainedSelectionToolbar" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="RetainedSelectionText" VerticalAlignment="Center" FontSize="12" />
                    <Button x:Name="IncludeSelectedButton" Click="IncludeSelectedButton_Click" IsEnabled="False" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
        <Grid x:Name="PreviewViewport" Grid.Row="2" SizeChanged="PreviewViewport_SizeChanged">
            <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                          SizeChanged="PreviewScrollViewer_SizeChanged">
                <ContentControl x:Name="PreviewContent" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <ContentControl x:Name="TargetSelectionHost" HorizontalContentAlignment="Stretch">
                        <Grid x:Name="TargetRows" ColumnSpacing="12" RowSpacing="12" Padding="0,0,4,0"
                              SizeChanged="TargetRows_SizeChanged">
                            <Grid.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="22" IsStaggeringEnabled="True" />
                                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </Grid.ChildrenTransitions>
                        </Grid>
                    </ContentControl>
                    <TextBlock x:Name="EmptyPreviewText" TextWrapping="Wrap" Visibility="Collapsed"
                               Margin="8,24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="RetainedItemsPanel" Spacing="10" Visibility="Collapsed">
                        <Grid x:Name="RetainedRows" ColumnSpacing="12" RowSpacing="12" Padding="0,0,4,0" />
                        <TextBlock x:Name="RetainedEmptyText" TextWrapping="Wrap" Visibility="Collapsed"
                                   Margin="8,24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid x:Name="CompletedItemsPanel" ColumnSpacing="12" RowSpacing="12" Padding="0,0,4,0" Visibility="Collapsed" />
                  </StackPanel>
                </ContentControl>
            </ScrollViewer>
            <StackPanel x:Name="ScanBusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing Width="30" Height="30" IsActive="True" />
                <TextBlock x:Name="ScanBusyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <StackPanel x:Name="ExecutionProgressPanel" Grid.Row="3" Spacing="8" Visibility="Collapsed">
            <ProgressBar x:Name="ExecutionProgressBar" Maximum="1" Minimum="0" Value="0" />
            <TextBlock x:Name="ExecutionProgressText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border x:Name="BottomBar" Grid.Row="4" CornerRadius="18" BorderThickness="1" BorderBrush="#F0E2BE"
                Background="#FFFFF7E2" Padding="14,9,10,9">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="FooterSummaryText" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="UndoButton" Grid.Column="1" Click="UndoButton_Click" Visibility="Collapsed" />
                <Button x:Name="AbandonUndoButton" Grid.Column="2" Click="AbandonUndoButton_Click" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Grid.Column="3" Click="CancelButton_Click" />
                <Button x:Name="DoneButton" Grid.Column="3" Click="DoneButton_Click"
                        Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                <Button x:Name="RetryPublicButton" Grid.Column="4" Click="RetryPublicButton_Click"
                        Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                <Button x:Name="ExecuteButton" Grid.Column="4" MinWidth="190" Height="42" FontSize="14" FontWeight="SemiBold" CornerRadius="14" Click="ExecuteButton_Click"
                        IsEnabled="False" Background="#FFD75E" Foreground="#252216" BorderBrush="#E9BA3C" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
