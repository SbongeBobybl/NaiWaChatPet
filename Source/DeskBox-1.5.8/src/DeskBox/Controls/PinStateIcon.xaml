<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.PinStateIcon"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Viewbox Stretch="Uniform">
        <Grid Width="16" Height="16">
            <Path
                x:Name="UnpinnedPath"
                Data="M4,1 L12,1 L12,3 L11,3 L10.5,7.5 L13,10 L13,11 L8.75,11 L8.4,15.5 L7.6,15.5 L7.25,11 L3,11 L3,10 L5.5,7.5 L5,3 L4,3 Z"
                Fill="Transparent"
                Stroke="{x:Bind Foreground, Mode=OneWay}"
                StrokeLineJoin="Round"
                StrokeThickness="1.15" />
            <Path
                x:Name="PinnedPath"
                Data="M4,1 L12,1 L12,3 L11,3 L10.5,7.5 L13,10 L13,11 L8.75,11 L8.4,15.5 L7.6,15.5 L7.25,11 L3,11 L3,10 L5.5,7.5 L5,3 L4,3 Z"
                Fill="{x:Bind Foreground, Mode=OneWay}"
                Visibility="Collapsed" />
        </Grid>
    </Viewbox>
</UserControl>
